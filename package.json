{
  "name": "wikichat",
  "version": "2.0.0",
  "description": "Serveur MCP local de coordination multi-agents pour Claude Code — canaux, DM, tâches, spawning, dashboard.",
  "type": "module",
  "main": "server.mjs",
  "bin": {
    "wikichat": "./server.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "start:team": "node scripts/start-with-team.mjs",
    "dev": "node --watch server.mjs",
    "test": "node test-e2e.mjs",
    "install-service": "node scripts/install-service.mjs",
    "uninstall-service": "node scripts/uninstall-service.mjs"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "multi-agent",
    "coordination",
    "sse",
    "spawning",
    "dashboard"
  ],
  "author": "Nicolas LAVAL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nic01asFr/Wikichat.git"
  },
  "bugs": {
    "url": "https://github.com/nic01asFr/Wikichat/issues"
  },
  "homepage": "https://github.com/nic01asFr/Wikichat#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chokidar": "^5.0.0",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  }
}
